{
  "name": "fppdesign-2018",
  "description": "FPP design website using Gatsby",
  "license": "UNLICENSED",
  "scripts": {
    "cssnano": "postcss ./src/css/jb-lazysizes.css -u cssnano -o ./src/css/jb-lazysizes.min.css --no-map",
    "cache": "rm -rf .cache",
    "develop": "cross-env NODE_ENV=development NODE_OPTIONS=--openssl-legacy-provider && gatsby develop",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider gatsby build",
    "serve": "gatsby serve",
    "icons": "pngquant --force --speed=1 --quality=10-30 --ext=.png -- ./public/icons/*.png"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": false,
    "printWidth": 100
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true,
      "commonjs": true
    },
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": 2018
    }
  },
  "dependencies": {
    "compass-vertical-rhythm": "^1.4.5",
    "cross-env": "^5.2.0",
    "gatsby": "^2.3.7",
    "gatsby-plugin-catch-links": "^2.0.13",
    "gatsby-plugin-manifest": "^2.0.26",
    "gatsby-plugin-netlify": "^2.0.13",
    "gatsby-plugin-offline": "^2.0.25",
    "gatsby-plugin-react-helmet": "^3.0.11",
    "gatsby-plugin-sass": "^2.0.11",
    "gatsby-plugin-typography": "^2.2.10",
    "gatsby-source-wordpress": "^3.0.51",
    "lazysizes": "^4.1.7",
    "react": "^16.8.6",
    "react-custom-ampersand": "1.1.7",
    "react-dom": "^16.8.6",
    "react-helmet": "^5.2.0",
    "react-typography": "^0.16.19",
    "sass": "^1.89.2",
    "sharp": "^0.32.0",
    "typography": "^0.16.19",
    "typography-theme-twin-peaks": "^0.16.19"
  },
  "resolutions": {
    "sharp": "^0.32.0"
  },
  "packageManager": "yarn@4.6.0+sha512.5383cc12567a95f1d668fbe762dfe0075c595b4bfff433be478dbbe24e05251a8e8c3eb992a986667c1d53b6c3a9c85b8398c35a960587fbd9fa3a0915406728"
}
