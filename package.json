{
  "name": "fppdesign-2018",
  "description": "FPP design website using Gatsby",
  "license": "UNLICENSED",
  "scripts": {
    "cssnano": "postcss ./src/css/jb-lazysizes.css -u cssnano -o ./src/css/jb-lazysizes.min.css --no-map",
    "cache": "rm -rf .cache",
    "develop": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "icons": "pngquant --force --speed=1 --quality=10-30 --ext=.png -- ./public/icons/*.png"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": false,
    "printWidth": 100
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2022": true,
      "commonjs": true
    },
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": "latest",
      "ecmaFeatures": {
        "jsx": true
      }
    }
  },
  "dependencies": {
    "compass-vertical-rhythm": "^1.4.5",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.0",
    "gatsby": "^5.13.0",
    "gatsby-plugin-catch-links": "^5.13.0",
    "gatsby-plugin-manifest": "^5.13.0",
    "gatsby-plugin-netlify": "^5.1.0",
    "gatsby-plugin-offline": "^6.13.0",
    "gatsby-plugin-sass": "^6.13.0",
    "gatsby-plugin-typography": "^5.13.0",
    "gatsby-source-wordpress": "^7.13.0",
    "lazysizes": "^5.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-typography": "^0.16.19",
    "sass": "^1.89.2",
    "sharp": "^0.32.0",
    "typography": "^0.16.19",
    "typography-theme-twin-peaks": "^0.16.19"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.32.0"
    }
  },
  "packageManager": "pnpm@9.15.2"
}
