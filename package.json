{
  "name": "fppdesign-2018",
  "description": "FPP design website using Gatsby",
  "license": "UNLICENSED",
  "scripts": {
    "cache": "rm -rf .cache",
    "develop": "cross-env NODE_ENV=development && gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "icons": "pngquant --force --speed=1 --quality=10-30 --ext=.png -- ./public/icons/*.png"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": false,
    "printWidth": 100
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true,
      "commonjs": true
    },
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": 2018
    }
  },
  "dependencies": {
    "compass-vertical-rhythm": "^1.4.5",
    "cross-env": "^5.2.0",
    "gatsby": "^2.3.7",
    "gatsby-plugin-catch-links": "^2.0.13",
    "gatsby-plugin-manifest": "^2.0.26",
    "gatsby-plugin-netlify": "^2.0.13",
    "gatsby-plugin-offline": "^2.0.25",
    "gatsby-plugin-react-helmet": "^3.0.11",
    "gatsby-plugin-sass": "^2.0.11",
    "gatsby-plugin-typography": "^2.2.10",
    "gatsby-source-wordpress": "^3.0.51",
    "lazysizes": "^4.1.7",
    "node-sass": "^4.11.0",
    "react": "^16.8.6",
    "react-custom-ampersand": "1.1.7",
    "react-dom": "^16.8.6",
    "react-helmet": "^5.2.0",
    "react-typography": "^0.16.19",
    "typography": "^0.16.19",
    "typography-theme-twin-peaks": "^0.16.19"
  }
}
