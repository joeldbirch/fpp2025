{
  "name": "fppdesign-2018",
  "description": "FPP design website using Gatsby",
  "license": "UNLICENSED",
  "scripts": {
    "cssnano": "postcss ./src/css/jb-lazysizes.css -u cssnano -o ./src/css/jb-lazysizes.min.css --no-map",
    "cache": "rm -rf .cache",
    "develop": "cross-env NODE_ENV=development && gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "icons": "pngquant --force --speed=1 --quality=10-30 --ext=.png -- ./public/icons/*.png"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": false,
    "printWidth": 100
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true,
      "commonjs": true
    },
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": 2018
    }
  },
  "dependencies": {
    "compass-vertical-rhythm": "^1.4.5",
    "cross-env": "^7.0.3",
    "gatsby": "^5.0.0",
    "gatsby-plugin-catch-links": "^5.0.0",
    "gatsby-plugin-manifest": "^5.0.0",
    "gatsby-plugin-netlify": "^5.0.0",
    "gatsby-plugin-offline": "^6.0.0",
    "gatsby-plugin-react-helmet": "^6.0.0",
    "gatsby-plugin-sass": "^6.0.0",
    "gatsby-plugin-typography": "^5.0.0",
    "gatsby-source-wordpress": "^3.0.51",
    "lazysizes": "^5.3.2",
    "react": "^18.3.1",
    "react-custom-ampersand": "1.1.7",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-typography": "^0.16.23",
    "sass": "^1.83.0",
    "typography": "^0.16.24",
    "typography-theme-twin-peaks": "^0.16.19"
  },
  "packageManager": "yarn@4.6.0+sha512.5383cc12567a95f1d668fbe762dfe0075c595b4bfff433be478dbbe24e05251a8e8c3eb992a986667c1d53b6c3a9c85b8398c35a960587fbd9fa3a0915406728"
}
